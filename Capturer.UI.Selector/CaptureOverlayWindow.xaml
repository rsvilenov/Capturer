<Window x:Class="Capturer.UI.Selector.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Capturer.UI.Selector"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        xmlns:behaviors="clr-namespace:Capturer.UI.Technical.Behaviors;assembly=Capturer.UI.Technical"
        xmlns:converters="clr-namespace:Capturer.UI.Technical.Converters;assembly=Capturer.UI.Technical"
        mc:Ignorable="d"
    Title="CaptureOverlayWindow">
    <!-- we need this to ensure the transparency of the window, with just a minimal alpha channel (the "01" at the beginning)-->
    <Window.Background>
        <!--<SolidColorBrush Color="#01000000" />-->
        <SolidColorBrush Color="Transparent" />
    </Window.Background>
    <!--<Window.AllowsTransparency>True</Window.AllowsTransparency>-->
    <!--the window should cover the entire screen, including the taskbar area -->
    <Window.WindowState>
        <WindowState>Maximized</WindowState>
    </Window.WindowState>
    <!-- top most, over all other windows -->
    <!-- <Window.Topmost>True</Window.Topmost> -->
    <Window.WindowStartupLocation>CenterScreen</Window.WindowStartupLocation>
    <!--we don't want any nonclient area controls (top buttons, resize handlers, captions, etc)-->
    <Window.ResizeMode>NoResize</Window.ResizeMode>
    <Window.WindowStyle>None</Window.WindowStyle>
    <Window.SnapsToDevicePixels>True</Window.SnapsToDevicePixels>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Capturer.UI.DefaultStyle;component/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:DivideConverter x:Key="DivideConverter" />
            <converters:RectConverter x:Key="RectConverter" />
            <converters:BooleanAndConverter x:Key="BooleanAndConverter" />
            <converters:MultivalueToPointConverter x:Key="MultivalueToPointConverter" />
            
        </ResourceDictionary>
       
    </Window.Resources>
    <Canvas x:Name="mainCanvas" SnapsToDevicePixels="True" >
        <Image SnapsToDevicePixels="True" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"
                Canvas.Top="0" Canvas.Left="0" Width="{Binding ActualWidth, ElementName=mainCanvas}" Height="{Binding ActualHeight, ElementName=mainCanvas}"
               x:Name="backgroundImg">
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementRemoveOffsetBehavior />
            </i:Interaction.Behaviors>
        </Image>
        
        <!-- http://stackoverflow.com/questions/5123747/how-to-overlay-a-color-onto-a-canvas-and-also-add-an-exlusion-region-in-wpf -->
        <Rectangle SnapsToDevicePixels="True"  RenderOptions.EdgeMode="Aliased"
            Fill="Black" Canvas.Top="-3" Canvas.Left="0" Width="{Binding ActualWidth, ElementName=mainCanvas}" Height="{Binding ActualHeight, ElementName=mainCanvas}" Name="rect">
            
            <Rectangle.CacheMode>
                <BitmapCache />
            </Rectangle.CacheMode>
            <Rectangle.OpacityMask>
                <!-- http://stackoverflow.com/questions/10998894/wpf-opacitymask-not-behaving-as-expected-->
                <DrawingBrush ViewboxUnits="Absolute" ViewportUnits="Absolute"
            
                    Stretch="None" Opacity="0.8">
                    <DrawingBrush.Viewbox>
                        <MultiBinding Converter="{StaticResource RectConverter}">
                            <Binding Path="(Canvas.Left)" ElementName="rect"/>
                            <Binding Path="(Canvas.Top)" ElementName="rect"/>
                            <Binding Path="Width" ElementName="rect"/>
                            <Binding Path="Height" ElementName="rect"/>
                        </MultiBinding>
                    </DrawingBrush.Viewbox>
                    <DrawingBrush.Viewport>
                        <MultiBinding Converter="{StaticResource RectConverter}">
                            <Binding Path="(Canvas.Left)" ElementName="rect"/>
                            <Binding Path="(Canvas.Top)" ElementName="rect"/>
                            <Binding Path="Width" ElementName="rect"/>
                            <Binding Path="Height" ElementName="rect"/>
                        </MultiBinding>
                    </DrawingBrush.Viewport>
                    
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#99ffffff">
                            <GeometryDrawing.Geometry>
                                <CombinedGeometry GeometryCombineMode="Exclude">
                                    <CombinedGeometry.Geometry1>
                                        
                                        <RectangleGeometry>
                                            <RectangleGeometry.Rect>
                                                <MultiBinding Converter="{StaticResource RectConverter}">
                                                    <Binding Path="(Canvas.Left)" ElementName="rect"/>
                                                    <Binding Path="(Canvas.Top)" ElementName="rect"/>
                                                    <Binding Path="Width" ElementName="rect"/>
                                                    <Binding Path="Height" ElementName="rect"/>
                                                </MultiBinding>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <RectangleGeometry>
                                            <RectangleGeometry.Rect>
                                                <MultiBinding Converter="{StaticResource RectConverter}">
                                                    <Binding Path="(Canvas.Left)" ElementName="selectorInnerControl"/>
                                                    <Binding Path="(Canvas.Top)" ElementName="selectorInnerControl"/>
                                                    <Binding Path="Width" ElementName="selectorInnerControl"/>
                                                    <Binding Path="Height" ElementName="selectorInnerControl"/>
                                                </MultiBinding>
                                            </RectangleGeometry.Rect>
                                        </RectangleGeometry>
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <Button 
            x:Name="vertScroll"
            Visibility="Collapsed"
            Style="{StaticResource ButtonStyle_VerticalAutoScroll}" 
            Width="20" Height="40" 
            Canvas.Top="130"
            Canvas.Left="130"
            />

        <Button 
            x:Name="horizScroll"
            Visibility="Collapsed"
            Style="{StaticResource ButtonStyle_HorizontalAutoScroll}" 
            Width="40" Height="20" 
            Canvas.Top="130"
            Canvas.Left="130"
            />

        <!-- Visibility="{Binding Resizing, Converter={StaticResource BooleanToVisibilityConverter}}"
            -->
        <Label x:Name="indicator"
               IsEnabled="{Binding Resizing}"
                   Style="{DynamicResource Label_SizeIndicator}"
                Panel.ZIndex="160"
                Canvas.Top="50" Canvas.Left="50" Width="80" Height="15" >
            <Label.ContentTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} x {1}">
                                <Binding ElementName="selectorInnerControl" Path="ActualHeight" />
                                <Binding ElementName="selectorInnerControl" Path="ActualWidth" />
                            </MultiBinding>
                        </TextBlock.Text>

                    </TextBlock>
                </DataTemplate>

            </Label.ContentTemplate>
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementFollowMouseBehavior 
                    InitialHorizontalPlacementRelativeToMouse="Right"
                    MousePosition="{Binding ElementName=resizeBeh, Path=ResizingMousePosition}" />
            </i:Interaction.Behaviors>
        </Label>

        <!-- screenwide cross -->
        <!-- we will use this grid as a 1px cursor -->
        <Grid Background="Orange"  Width="1" Height="1" x:Name="cursorElement" />

        

        <!-- draw the horizontal lines -->
        <Line Canvas.Top="{Binding MousePosition.Y}" 
              Stroke="Gray" 
              Height="1"
              SnapsToDevicePixels="True"
               RenderOptions.EdgeMode="Aliased"
              Visibility="{Binding ScreenwideCrossVisibility}"
              X2="{Binding ElementName=mainCanvas, Path=ActualWidth}">
            <Line.CacheMode>
                <BitmapCache RenderAtScale="1"/>
            </Line.CacheMode>
        </Line>

        <Line  Canvas.Top="{Binding MousePosition.Y}" 
               Stroke="Orange"
              StrokeDashOffset="5"
              StrokeDashArray="5 5" 
               Height="1"
               SnapsToDevicePixels="True"
               RenderOptions.EdgeMode="Aliased"
               Visibility="{Binding ScreenwideCrossVisibility}"
               X2="{Binding ElementName=mainCanvas, Path=ActualWidth}">
            <Line.CacheMode>
                <BitmapCache RenderAtScale="1"/>
            </Line.CacheMode>
        </Line>

        <!-- draw the vertical lines -->
         <!-- first draw a solid line -->
        <Line Canvas.Top="0"
               Canvas.Left="{Binding MousePosition.X}"
               X1="0" X2="0"
               Stroke="Gray"  
               Width="1"
              SnapsToDevicePixels="True"
               RenderOptions.EdgeMode="Aliased"
              Visibility="{Binding ScreenwideCrossVisibility}"
               Y1="0"
               Y2="{Binding ElementName=mainCanvas, Path=ActualHeight}">
            <Line.CacheMode>
                <BitmapCache RenderAtScale="1"/>
            </Line.CacheMode>
        </Line>

        <!-- and then a pubctured line on top of the solid one -->
        <Line  Canvas.Top="0"
               Canvas.Left="{Binding MousePosition.X}"
               X1="0" X2="0"
               Stroke="Orange" 
               Width="1"
              SnapsToDevicePixels="True"
               RenderOptions.EdgeMode="Aliased"
              StrokeDashOffset="5"
              StrokeDashArray="5 5" 
               Visibility="{Binding ScreenwideCrossVisibility}"
               Y1="0"
               Y2="{Binding ElementName=mainCanvas, Path=ActualHeight}">
            <Line.CacheMode>
                <BitmapCache RenderAtScale="1"/>
            </Line.CacheMode>
        </Line>

        <Grid x:Name="vScrollLabel" Visibility="Collapsed">
            <Border Opacity="0.8" CornerRadius="3" Background="Black" />
            <Label Foreground="White" Content="Capture vertical scrolling content" />
        </Grid>
        <Grid x:Name="hScrollLabel" Visibility="Collapsed">
            <Border Opacity="0.8" CornerRadius="3" Background="Black" />
            <Label Foreground="White" Content="Capture horizontal scrolling content" />
        </Grid>

        <local:Crosshair ActualScreenLocation="{Binding CrosshairActualPosition, Mode=OneWayToSource}"
                         Width="100" Height="100" Visibility="{Binding ScreenwideCrossVisibility}">
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementPositionToCenterBehavior DesiredCenterPoint="{Binding MousePosition}" />
            </i:Interaction.Behaviors>
            
        </local:Crosshair>

        <!---->

        <local:Magnifier x:Name="magnifier" Canvas.Top="150" Canvas.Left="150" Text="1024 x 768" IsEnabled="{Binding Resizing, Converter={StaticResource InverseBooleanConverter}}"
            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"
           PlaceTextOnTop="True"
           LabelBackgroundColor="Gray"
           LabelBackgroundOpacity="0.6"
                         >
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementFollowMouseBehavior 
                    InitialHorizontalPlacementRelativeToMouse="Left"
                    ActualVerticalPlacementRelativeToMouse="{Binding MagnifierVerticalPlacement, Mode=OneWayToSource}"
                    MousePosition="{Binding MousePosition}" />
            </i:Interaction.Behaviors>
            <local:Magnifier.CacheMode>
                <BitmapCache EnableClearType="true" RenderAtScale="1"/>
            </local:Magnifier.CacheMode>
        </local:Magnifier>

        <ContentControl  x:Name="selectorInnerControl"
            >

                
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementMouseSelectionBox
                    Enabled="{Binding MouseDragSelectionMode}"
                    StartPosition="{Binding MouseSelectionBoxStartPosition}"
                    MousePosition="{Binding MousePosition}" />
                <behaviors:StyleSelectorBehavior SelectedStyleIndex="{Binding SelectorBorderStyleIndex, Mode=TwoWay}">
                    <behaviors:StyleSelectorBehavior.StylesResourceKeys>
                        <system:String>ContentControlStyle_MarchingAntsBorder</system:String>
                        <system:String>ContentControlStyle_SolidBorder</system:String>
                    </behaviors:StyleSelectorBehavior.StylesResourceKeys>
                </behaviors:StyleSelectorBehavior>
                <behaviors:CanvasElementAnimateMoveResizeBehavior 
                    NewHight="{Binding SelectBoxNewHeight}" 
                    NewWidth="{Binding SelectBoxNewWidth}"
                    NewCanvasLeft="{Binding SelectBoxNewCanvasLeft}"
                    NewCanvasTop="{Binding SelectBoxNewCanvasTop}"
                    >
                    <behaviors:CanvasElementAnimateMoveResizeBehavior.Enabled>
                        <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                            <Binding Path="ManualSelectionMode" Converter="{StaticResource InverseBooleanConverter}" />
                            <Binding Path="MouseDragSelectionMode"  Converter="{StaticResource InverseBooleanConverter}" />
                        </MultiBinding>
                    </behaviors:CanvasElementAnimateMoveResizeBehavior.Enabled>
                </behaviors:CanvasElementAnimateMoveResizeBehavior>
                <behaviors:CanvasElementDragBehavior Enabled="{Binding ManualSelectionMode}"/>
                <behaviors:CanvasElementResizeBehavior x:Name="resizeBeh" ResizeEnabled="{Binding ManualSelectionMode}"
                    Resizing="{Binding Resizing, Mode=OneWayToSource}"
                    ShowMiddleHandles="True"/>
            </i:Interaction.Behaviors>

            <Control Opacity="0.0">
                
            </Control>
        </ContentControl>
        

        <!--<ContentControl
            Style="{StaticResource ContentControlStyle_MarchingAntsBorder}" 
            Canvas.Left="{Binding SelectBoxNewHeight}" 
            Canvas.Top="{Binding SelectBoxNewCanvasTop}" 
            Height="{Binding SelectBoxNewHeight}"  
            Width="{Binding SelectBoxNewWidth}"
            Cursor="ScrollAll"
            Visibility="Collapsed"
            Panel.ZIndex="150"
            x:Name="autoSelector">
            <i:Interaction.Behaviors>
                <behaviors:CanvasElementDragBehavior/>
                <behaviors:CanvasElementResizeBehavior x:Name="resizeBeh"
                    Resizing="{Binding Resizing, Mode=OneWayToSource}"
                    ShowMiddleHandles="True"/>
                
            </i:Interaction.Behaviors>

            <Control Opacity="0.0" Name="selectionBox1" >

            </Control>
        </ContentControl>-->
        
    </Canvas>
</Window>

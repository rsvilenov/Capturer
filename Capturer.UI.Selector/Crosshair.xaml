<UserControl x:Class="Capturer.UI.Selector.Crosshair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capturer.UI.Selector"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <!-- quick and dirty layout fix - otherwise the crosshair shows slightly to the right and bottom from the screenwide lines -->
        <Grid.Margin>
            <Thickness Top="-1" Left="-1" Bottom="0" Right="0" />
        </Grid.Margin>
        <Grid.CacheMode>
            <BitmapCache EnableClearType="true" RenderAtScale="1"/>
        </Grid.CacheMode>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition />
            <ColumnDefinition Width="1"/>
            <ColumnDefinition />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" />
            <RowDefinition />
            <RowDefinition Height="1"/>
            <RowDefinition />
            <RowDefinition Height="1.5*" />
        </Grid.RowDefinitions>
        
        <!-- left thick line -->
        <Rectangle Grid.Column="0"
                Grid.Row="1"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased">
        </Rectangle>
        

        <Rectangle Grid.Column="0"
                Grid.Row="2"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Center" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />
        
        <Rectangle Grid.Column="0"
                Grid.Row="3"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Top" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <!-- left thin line -->
        <Rectangle Grid.Column="1"
                Grid.Row="2"
               Stroke="Red" 
              StrokeThickness="1"
              Stretch="Fill"
              VerticalAlignment="Center" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <!-- center rectangle -->
        <Rectangle Grid.Column="2"
                Grid.Row="2"
                x:Name="CCH_CenterRectangle"
             Stroke="Transparent" 
              StrokeThickness="1"
              Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- right thin line -->
        <Rectangle Grid.Column="3"
                Grid.Row="2"
              Stroke="Red" 
              StrokeThickness="1"
              Stretch="Fill"
              VerticalAlignment="Center" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <!-- right thick line -->
        <Rectangle Grid.Column="4"
                Grid.Row="1"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="4"
                Grid.Row="2"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Center" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="4"
                Grid.Row="3"
              Stroke="Red" 
              Height="1"
              Stretch="Fill"
              VerticalAlignment="Top" 
              HorizontalAlignment="Stretch"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />
        
        <!-- top thick line -->


        <Rectangle Grid.Column="1"
                Grid.Row="0"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Right"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="2"
                Grid.Row="0"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Center"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="3"
                Grid.Row="0"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Left"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />
        
        <!-- top thin line -->
        <Rectangle Grid.Column="2"
                Grid.Row="1"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Center"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <!-- bottom tnin line -->
        <Rectangle Grid.Column="2"
                Grid.Row="3"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Center"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />
        
        <!-- bottom thick line -->

        <Rectangle Grid.Column="1"
                Grid.Row="4"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Right"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="2"
                Grid.Row="4"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Center"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />

        <Rectangle Grid.Column="3"
                Grid.Row="4"
              Stroke="Red" 
              Width="1"
              Stretch="Fill"
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Left"
              SnapsToDevicePixels="True"
              RenderOptions.EdgeMode="Aliased" />
        
    </Grid>
</UserControl>

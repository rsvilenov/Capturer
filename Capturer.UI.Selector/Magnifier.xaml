<UserControl x:Class="Capturer.UI.Selector.Magnifier"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Capturer.UI.Selector"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="150">
    <Grid x:Name="mainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border x:Name="topLabel"
                CornerRadius="5" 
                Width="149" 
                Height="110" 
                Grid.Row="0" 
                Grid.RowSpan="2" 
                BorderBrush="Red" 
                Visibility="Collapsed"
                BorderThickness="1">
            <Grid>
                <Border Opacity="{Binding LabelBackgroundOpacity}" >
                    <Border.Background>
                        <SolidColorBrush Color="{Binding LabelBackgroundColor}" />
                    </Border.Background>
                </Border>

                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 5, 0, 0">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding LabelForegroundColor}" />
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Border>
        <Border x:Name="bottomLabel"
                CornerRadius="5" 
                Width="149" 
                Height="100" 
                Grid.Row="2" 
                Grid.RowSpan="2" 
                BorderBrush="Red" 
                BorderThickness="1">
            <Grid>
                <Border Opacity="{Binding LabelBackgroundOpacity}" >
                    <Border.Background>
                        <SolidColorBrush Color="{Binding LabelBackgroundColor}" />
                    </Border.Background>
                </Border>

                <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0, 0, 0, 5">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding LabelForegroundColor}" />
                    </TextBlock.Foreground>
                </TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row="1"
          Grid.RowSpan="2">

            <Ellipse x:Name="ellipse"
                 
                 Fill="Gray"
          Height="150"
          Width="150"
          StrokeThickness="5"
          Stroke="Gray" 
          RenderOptions.BitmapScalingMode="NearestNeighbor"  
          RenderOptions.EdgeMode="Unspecified" 
          SnapsToDevicePixels="True"
          UseLayoutRounding="True" >

            </Ellipse>


            <Rectangle Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="1" Fill="Red" Stroke="Red"/>
            <Rectangle Margin="0,5,0,5" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="1" Fill="Red" Stroke="Red"/>
        </Grid>
        
            
    </Grid>
</UserControl>
